<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="克制时刻"
        android:textColor="#1C283A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#198F66"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="次 · 今日成功"
            android:textColor="#6C798A"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="累计 0 次"
        android:textColor="#6C798A"
        android:textSize="12sp" />

    <Button
        android:id="@+id/widget_checkin_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#198F66"
        android:text="✓ 我克服了"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
